{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@xuanyuku/shared": ["packages/shared/src/index.ts"],
      "@xuanyuku/shared/*": ["packages/shared/src/*.ts"]
    }
  }
}